# Copy to .env (never committed) or set in the shell / systemd environment file.

# The SQLite file Fern creates and the web app reads. Both processes must see
# the same path. Default: data/conservatory.db under the repo.
CONSERVATORY_DB=data/conservatory.db

# Where photos and thumbnails live (photos/), and the species reference
# images Fern fetches (reference/). Default: data/
CONSERVATORY_DATA=data

# Pl@ntNet API key (free account at https://my.plantnet.org). Fern only;
# the web app never calls Pl@ntNet.
PLANTNET_API_KEY=

# Vercel AI Gateway key, for the care sheets Fern writes. Optional: unset,
# there are no care sheets and the species page says so. The web app only
# checks that it is set, to offer Rewrite.
AI_GATEWAY_API_KEY=

# The gateway model slug for care sheets. Default: anthropic/claude-sonnet-5.5
#CONSERVATORY_LLM=anthropic/claude-sonnet-5.5

# The household's USDA hardiness zone, e.g. 6a. Optional.
#CONSERVATORY_ZONE=6a

# Health checks of a plant's photos (the plant page's "Check health"), on with
# the gateway key above. The model slug Fern asks, apart from CONSERVATORY_LLM
# so another can be tried here alone. Default: anthropic/claude-sonnet-5.5
#CONSERVATORY_HEALTH_LLM=anthropic/claude-sonnet-5.5

# How many health checks the household may start in a day, by the station's
# own calendar. Web app only. Default: 20
#CONSERVATORY_HEALTH_DAILY_MAX=20

# The address every pot tag's QR code carries: a tag opens
# <CONSERVATORY_URL>/t/<plant id>. Web app only, read at runtime and never
# taken from the request. Unset, no code is drawn and Print is off. At the
# desk, the dev server's LAN address, so a phone can scan a test print.
#CONSERVATORY_URL=http://192.168.1.40:3000
