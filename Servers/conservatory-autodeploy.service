# The Conservatory's deploy watcher on orchid (issue #9): Servers/autodeploy.sh
# in the checkout it deploys. Root on purpose (restarts without a sudo
# password); every git, pip and pnpm step is demoted to todd inside the
# script. Beside the Aviary's aviary-autodeploy, never shared with it.

[Unit]
Description=The Conservatory -- deploy watcher (merges to main deploy themselves)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/home/todd/conservatory/Servers/autodeploy.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
